# Azure AI Foundry project endpoint
# Get this from Azure AI Foundry project overview.
# Example:
# https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>
AZURE_AI_PROJECT_ENDPOINT="https://hakunamatata11.services.ai.azure.com/api/projects/hakunamatata"

# Judge model deployment name available in the same Azure AI Foundry project.
# Example: gpt-4o-mini or gpt-4o
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.4-mini"

# Existing Foundry Agent name.
# Use the exact agent name shown in Azure AI Foundry.
AGENT_NAME="it-support-agent"

# Optional. Leave blank to use the latest available version.
AGENT_VERSION=

# Dataset upload details
DATASET_NAME=agent-test-queries
DATASET_VERSION=1

# Evaluation details shown in Foundry portal
EVALUATION_NAME=Advanced Agent Quality Evaluation
EVALUATION_RUN_NAME=Agent Evaluation Run - SDK Lab

# Built-in evaluators to run along with generated rubric evaluator.
# Keep this simple for learners. You can add more supported built-in evaluators if required.
BUILTIN_EVALUATORS=builtin.violence,builtin.coherence
